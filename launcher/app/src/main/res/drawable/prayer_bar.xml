<?xml version="1.0" encoding="utf-8"?>
<!-- Prayer times bar on Home: a faint panel over the wallpaper, like the dock tray's glass but
     static — the row never takes focus, so it needs no blurred backdrop. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#12FFFFFF" />
    <stroke android:width="1dp" android:color="#24FFFFFF" />
    <corners android:radius="12dp" />
</shape>
